# Audit withGufran - Git Ignore File

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor/IDE Files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Node Modules (for future phases)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build/Distribution Files (for future phases)
dist/
build/
*.min.js
*.min.css

# Environment Variables
.env
.env.local
.env.development
.env.test
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary Files
tmp/
temp/
*.tmp
*.bak
*.cache

# Cache directory contents (keep the directory)
storage/cache/*.cache
storage/rate_limits/*.limit

# Large Design Files (use Git LFS if needed)
*.psd
*.ai
*.sketch
*.fig

# Compressed Files
*.zip
*.tar.gz
*.rar

# Database Files (for future phases)
*.sqlite
*.db

# Test Coverage (for future phases)
coverage/
.nyc_output/

# macOS
.AppleDouble
.LSOverride

# Windows
$RECYCLE.BIN/

# Linux
.directory

# Keep .gitkeep files
!.gitkeep
